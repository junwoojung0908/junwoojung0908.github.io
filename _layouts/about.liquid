---
layout: default
---
<div class="post">
  <article>
    <!-- Swiss masthead: eyebrow + headline lockup -->
    {% if page.eyebrow or page.headline %}
      <header class="masthead">
        {% if page.eyebrow %}
          <div class="eyebrow">{{ page.eyebrow }}</div>
        {% endif %}
        {% if page.headline %}
          <h1 class="headline">{{ page.headline }}</h1>
        {% endif %}
      </header>
    {% endif %}

    <div class="about-grid">
      <!-- Left: bio body -->
      <div class="clearfix about-bio">{{ content }}</div>

      <!-- Right: photo, caption, contact -->
      <aside class="about-side">
        {% if page.profile and page.profile.image %}
          <img
            src="{{ page.profile.image | prepend: 'assets/img/' | relative_url }}"
            alt="profile photo"
            class="side-photo"
          >
        {% endif %}
        {% if page.profile.more_info %}
          <div class="side-cap">{{ page.profile.more_info }}</div>
        {% endif %}

        {% if page.social %}
          <div class="contact">
            {%- if site.email -%}
              <a href="mailto:{{ site.email | encode_email }}"><b>email</b> — {{ site.email | replace: '@', ' (at) ' }}</a>
            {%- endif -%}
            {%- if site.scholar_userid -%}
              <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" rel="noopener noreferrer"
                ><b>google scholar</b></a
              >
            {%- endif -%}
            {%- if site.github_username -%}
              <a href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener noreferrer"><b>github</b></a>
            {%- endif -%}
            {%- if site.linkedin_username -%}
              <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}" target="_blank" rel="noopener noreferrer"><b>linkedin</b></a>
            {%- endif -%}
          </div>
        {% endif %}
      </aside>
    </div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
