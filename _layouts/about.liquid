---
layout: default
---
<div class="post">
  <article>
    {% if page.profile and page.profile.image %}
      <div class="profile-top">
        <img
          src="{{ page.profile.image | prepend: 'assets/img/' | relative_url }}"
          alt="profile photo"
          class="profile-top-img"
        >
        <p class="profile-subtitle">{{ page.subtitle }}</p>
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <!-- Social / contact links -->
    {% if page.social %}
      <div class="social">
        <div class="contact-text">
          {%- assign sep = '' -%}
          {%- if site.email -%}
            {{ sep -}}
            <a href="mailto:{{ site.email | encode_email }}">email</a>
            {%- assign sep = ' · ' -%}
          {%- endif -%}
          {%- if site.scholar_userid -%}
            {{ sep -}}
            <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" rel="noopener noreferrer">google scholar</a>
            {%- assign sep = ' · ' -%}
          {%- endif -%}
          {%- if site.github_username -%}
            {{ sep -}}
            <a href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener noreferrer">github</a>
            {%- assign sep = ' · ' -%}
          {%- endif -%}
          {%- if site.linkedin_username -%}
            {{ sep -}}
            <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}" target="_blank" rel="noopener noreferrer">linkedin</a>
            {%- assign sep = ' · ' -%}
          {%- endif -%}
        </div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    <div class="clearfix about-bio">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
